{
  "type": "row",
  "width": 220,
  "height": 40,
  "gap": 8,
  "children": [
    {
      "type": "image",
      "source": {
        "bind": "data.icon"
      },
      "width": 22,
      "height": 22,
      "stretch": "uniform"
    },
    {
      "type": "column",
      "width": 188,
      "height": 36,
      "gap": 0,
      "children": [
        {
          "type": "text",
          "bind": "data.label",
          "fontSize": 11,
          "fontWeight": "semibold",
          "height": 16
        },
        {
          "type": "text",
          "bind": "data.quota",
          "fontSize": 11,
          "height": 18,
          "marquee": true,
          "color": {
            "bind": "data.color",
            "fallback": "#FF222222"
          }
        }
      ]
    }
  ]
}
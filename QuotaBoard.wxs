<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="QuotaBoard" Language="2052" Version="1.0.6"
           Manufacturer="Othrik" UpgradeCode="A576641E-1FDD-4908-B5BF-5C0B66B9F4EE"
           Codepage="936">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Manufacturer="Othrik" Description="AI 额度悬浮窗：实时展示 ChatGPT / 豆包 / 智谱清言 / OpenAI / Kimi / 火山方舟 额度与用量"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Icon Id="QuotaBoardIcon" SourceFile="assets\QuotaBoard.ico" />
    <Property Id="ARPPRODUCTICON" Value="QuotaBoardIcon" />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="QuotaBoard" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="QuotaBoard" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="QuotaBoard" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="7BFB1588-7255-4949-9FDF-D2A36A9AC6CA" Win64="yes">
        <File Id="QuotaBoardExe" Name="QuotaBoard.exe" Source="dist\QuotaBoard.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="422D9889-59C6-4B22-B454-631C8A753846" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="QuotaBoard"
                  Description="AI 额度悬浮窗"
                  Target="[INSTALLFOLDER]QuotaBoard.exe" WorkingDirectory="INSTALLFOLDER" Icon="QuotaBoardIcon" IconIndex="0" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\QuotaBoard" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="7543EB8A-A7A6-4E47-AF57-E7E4002886A2" Win64="yes">
        <Shortcut Id="ApplicationDesktopShortcut" Name="QuotaBoard"
                  Description="AI 额度悬浮窗"
                  Target="[INSTALLFOLDER]QuotaBoard.exe" WorkingDirectory="INSTALLFOLDER" Icon="QuotaBoardIcon" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\QuotaBoard" Name="desktop"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
